# Copia este archivo a .env en el servidor o pega estas variables en EasyPanel.
# No uses el .env de desarrollo: ahí el panel apunta a localhost:5173.
# La contraseña de Postgres solo puede llevar letras y números.

POSTGRES_USER=loyalty
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=loyalty

DOCKER_WEB_ORIGIN=https://loyalty.intelekia.cloud
DOCKER_PUBLIC_BASE_URL=https://loyalty.intelekia.cloud
DOCKER_PUBLIC_WEB_URL=https://loyalty.intelekia.cloud
DOCKER_APPLE_WEB_SERVICE_URL=https://loyalty.intelekia.cloud/api/wallet/apple

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_ENCRYPTION_KEY=

APPLE_PASS_TYPE_IDENTIFIER=pass.com.intelekia.loyalty
APPLE_TEAM_IDENTIFIER=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=

GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_ORIGINS=https://loyalty.intelekia.cloud
GOOGLE_WALLET_LOGO_URL=
