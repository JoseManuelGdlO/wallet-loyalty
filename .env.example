NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://loyalty:loyalty@localhost:5432/loyalty
WEB_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-con-al-menos-32
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-con-al-menos-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
APP_ENCRYPTION_KEY=genera-32-bytes-en-base64
UPLOAD_DIR=uploads

# Apple Pass Type ID. Sin estos valores el sello se guarda, pero no se firma ni se empuja un pase.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_PATH=
APPLE_SIGNER_CERT_PATH=
APPLE_SIGNER_KEY_PATH=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WEB_SERVICE_URL=

# Google Wallet. La clase queda UNDER_REVIEW hasta que Google la apruebe.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_ORIGINS=http://localhost:5173
GOOGLE_WALLET_LOGO_URL=

# URL secreta de EasyPanel (Deployments → Deployment Trigger URL). No la subas al repositorio.
# EASYPANEL_DEPLOY_URL=
